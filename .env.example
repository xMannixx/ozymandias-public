# ============================================================
# Ozymandias — Environment Variables
# ============================================================
# Kopiere diese Datei als .env und fülle die Werte aus.
# NIEMALS .env committen!
# ============================================================

# --- Postgres ---
POSTGRES_USER=ozy
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ozymandias
DATABASE_URL=postgresql+asyncpg://ozy:changeme@postgres:5432/ozymandias

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (File Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=ozy-files

# --- JWT Auth ---
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
AUTH_DEV_BYPASS=false

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Owner Profile (optional, local only) ---
OWNER_EMAIL=
OWNER_NAME=
OWNER_PROFILE=
OWNER_LANGUAGE=Deutsch

# --- LLM Provider: DeepSeek (Default/Work) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- LLM Provider: Google Gemini (Talk/Creative) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- LLM Provider: Mistral ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

# --- LLM Provider: Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# --- LLM Provider: OpenAI (Tool-Calls, TTS, Whisper) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=tts-1
OPENAI_WHISPER_MODEL=whisper-1

# --- LLM Provider: Ollama (Lokal, Privacy/S3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- LLM Provider: LM Studio (Lokal, S4/Intimate) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# --- Celery (Background Tasks) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_AUTH_BYPASS=false

# --- Deployment ---
# DOMAIN=ozy.example.com
# ACME_EMAIL=admin@example.com
